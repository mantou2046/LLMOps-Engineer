# =============================================================================
# Langfuse 自托管 · 环境变量模板 —— W2 D9
# -----------------------------------------------------------------------------
# 用法：复制为 .env 并填入真值（.env 已被 .gitignore 挡住，不会提交）
#   cp infra/langfuse/.env.example infra/langfuse/.env
#
# ⚠️ 本文件**独立于仓库根 .env** —— 理由见 compose.yml 顶部注释：
#    官方 Langfuse 的变量名（POSTGRES_* / REDIS_AUTH / CLICKHOUSE_*）与项目库同名，
#    混用一个 .env 会让两套基础设施互相串值。
#
# ---- 怎么生成随机密钥 ----
#   Git Bash / Linux / macOS：
#       openssl rand -hex 32   # 生成 64 位十六进制串
#   本机 Git Bash 自带 openssl，直接用上面的命令即可。
#
# ⚠️ ENCRYPTION_KEY 必须是 **64 位十六进制**（32 字节），格式错 Langfuse 会拒绝启动。
# =============================================================================

# ---- 必填：三把密钥（不填 compose 会直接报错拒绝启动，这是刻意的）----
# 用于给会话/令牌签名
NEXTAUTH_SECRET=
# 用于给 Langfuse 内部数据加盐（哈希 API key 等）
SALT=
# 用于加密存储在库里的敏感凭据（如外部 LLM 的 key）
# ⚠️ 必须 64 位 hex，用 `openssl rand -hex 32` 生成
ENCRYPTION_KEY=

# ---- 必填：Langfuse 自己那个 Postgres ----
# ⚠️ 端口在宿主侧是 5433（避开项目库的 5432），但**容器内仍是 5432**，
#    所以这里的 DATABASE_URL 端口写 5432 不要改。
LANGFUSE_PG_USER=postgres
LANGFUSE_PG_PASSWORD=
LANGFUSE_PG_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/postgres

# ---- 必填：ClickHouse ----
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

# ---- 必填：Redis ----
REDIS_AUTH=

# ---- 必填：MinIO（对象存储）----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# ---- 可选：UI 地址（默认 http://localhost:3000）----
NEXTAUTH_URL=http://localhost:3000
# 关掉匿名遥测（本地学习环境没必要上报）
TELEMETRY_ENABLED=false

# ---- 可选：headless 初始化（一次启动建好组织/项目/API key/首个用户）----
# 留空 = 走 UI 手动 Sign up（本阶段推荐，能顺带熟悉界面）。
# 若要自动化，填下面几项，并把生成的 public/secret key 抄进仓库根 .env。
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
