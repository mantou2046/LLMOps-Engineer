# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ---- 模型 API ----
# 主模型（前沿模型，复杂问题走这条）
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=

# 便宜模型（简单问题分流走这条）
LLM_CHEAP_MODEL=
LLM_CHEAP_API_KEY=
LLM_CHEAP_BASE_URL=

# ---- 网关（LiteLLM，W4 起用）----
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_CACHE_ENABLED=true
LITELLM_CACHE_SIMILARITY_THRESHOLD=0.85

# ---- 数据库 / 向量库（pgvector）----
# compose 起库前必须先填 POSTGRES_PASSWORD，否则 infra/compose.yml 会拒绝启动
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llmops
POSTGRES_USER=llmops
POSTGRES_PASSWORD=

# ---- 可选：pgAdmin 图形化管理（infra/compose.yml 的 tools profile）----
# 只在 `--profile tools` 时用得到；日常不起，省内存
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=

# ---- 观测（Langfuse，自托管，W2 起用）----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 实验追踪（MLflow，W3 起用）----
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- 评估（W6 起用）----
RAGAS_JUDGE_MODEL=gpt-4o-mini
EVAL_GOLDEN_SET_PATH=evals/golden_set.jsonl
EVAL_PASS_THRESHOLD_FAITHFULNESS=0.80
EVAL_PASS_THRESHOLD_CONTEXT_RECALL=0.75
