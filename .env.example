# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ---- 模型 API ----
# 主模型（前沿模型，复杂问题走这条）
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=

# 便宜模型（简单问题分流走这条）
LLM_CHEAP_MODEL=
LLM_CHEAP_API_KEY=
LLM_CHEAP_BASE_URL=

# ---- 兜底通道（fallback，W2 D10 起用）----
# 语义：primary 档位重试**耗尽**仍失败 → 自动切到这条再试一次，成功则标 degraded=true。
# 两条典型用法（二选一或都填）：
#   ① 本地自托管（OpenAI 兼容端点）。W2 D10 实测结论：
#      · Ollama（推荐，CPU 友好）：BASE_URL=http://localhost:11434/v1，
#        MODEL=qwen2.5:0.5b，API_KEY 随便填（如 ollama）
#      · vLLM：本机无 GPU 时，CPU 镜像在 Docker Desktop/WSL2 下无法启动 → 见 DEC-019
#   ② 另一个托管 API（和 primary 不同厂商，避免同一家整体故障时一起挂）
# 留空 = 降级能力不存在，行为与加该功能前完全一致。
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# ---- 网关备用模型（LiteLLM 的 fallbacks 目标，W4 D5 起用）----
# ⚠️ 故意和 primary 用**不同变量**：演示 primary 故障时，只改坏 PRIMARY 的 base_url，
#    备用还得活着，否则 fallback 永远成功不了。生产上这两条应该是不同厂商。
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=

# ---- 网关（LiteLLM，W4 起用）----
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_CACHE_ENABLED=true
LITELLM_CACHE_SIMILARITY_THRESHOLD=0.85

# ---- 数据库 / 向量库（pgvector）----
# compose 起库前必须先填 POSTGRES_PASSWORD，否则 infra/compose.yml 会拒绝启动
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llmops
POSTGRES_USER=llmops
POSTGRES_PASSWORD=

# ---- 可选：pgAdmin 图形化管理（infra/compose.yml 的 tools profile）----
# 只在 `--profile tools` 时用得到；日常不起，省内存
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=

# ---- 观测（Langfuse，自托管，W2 起用）----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 实验追踪（MLflow，W3 起用）----
# 两套环境，按场景切换（DEC-028）：
#   A · 日常 —— 本机进程 `python -m mlflow server --port 5000`：快、随开随用
#   B · 演示 —— kind 集群内（helm release `mlflow`）：一条链路可复现
#      ⚠️ 用 B 需要 hosts 里有 `127.0.0.1 mlflow.llmops.local`
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_URI=http://mlflow.llmops.local

# ---- 评估（W6 起用）----
# 裁判必须用「已配 provider key」的模型：gpt-4o-mini 在 31415 聚合端点上只列名、无 key，调用直接 503
RAGAS_JUDGE_MODEL=deepseek-v4-flash
RAGAS_JUDGE_BASE_URL=http://127.0.0.1:31415/v1
# 本地 embedding（HF 直连与 hf-mirror 均不可达，模型从 ModelScope 取，见 scripts/fetch_embedding_model.sh）
RAGAS_EMBEDDING_MODEL=models/bge-small-zh-v1.5
RAGAS_EMBEDDING_DIM=512
EVAL_GOLDEN_SET_PATH=evals/golden_set.jsonl
EVAL_PASS_THRESHOLD_FAITHFULNESS=0.80
EVAL_PASS_THRESHOLD_CONTEXT_RECALL=0.75

# ---- 假上游（W5 D3 起用）----
# scripts/fake_upstream.py 的地址。网关的两个 local-* 别名指向它，
# 用来把 TTFT / 成本 / 缓存命中这些指标量准（真值已知才好断言）。
# ⚠️ 起法：D:/python314/python.exe scripts/fake_upstream.py --port 4010
FAKE_UPSTREAM_BASE_URL=http://127.0.0.1:4010/v1
