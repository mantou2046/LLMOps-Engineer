# =============================================================================
# ⚠️ 反面教材 · 朴素单阶段 Dockerfile
# -----------------------------------------------------------------------------
# 这个文件**故意写错**，唯一用途是给 scripts/verify_d2.sh 提供一个体积对比基准，
# 证明「多阶段构建到底省了多少」。
#
# 它故意犯的四个错（对照 Nana BP1–BP8）：
#   ① FROM python:3.12 而非 slim        → 基础镜像就多几百 MB
#   ② 不指定小版本                      → 违背 BP2「固定 tag」
#   ③ COPY . . 全量拷贝                 → 违背 BP5，且把 .git 等带进来
#      （注意：即使有 .dockerignore，非 slim 底 + root 运行仍是主要问题）
#   ④ 不切非 root                       → 违背 BP7
#   ⑤ 单阶段：编译器与缓存全部留在最终镜像 → 违背 BP6
#
# ❌ 不要在生产里用这个文件。
# =============================================================================

# ① 用完整版镜像（~1GB），且不锁小版本（②）
FROM python:3.12

WORKDIR /app

# ③ 全量拷贝：会把 src、notebooks、甚至 .env 一起带进来
COPY . .

# 依赖装进系统环境，不隔离 venv —— 依赖与系统混在一起，体积也无法精简
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

EXPOSE 8000

# ④ 不切用户：以 root 运行
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
